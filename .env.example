# Set these in Vercel → Project → Settings → Environment Variables. Never commit real values.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=        # only if your key is workspace-scoped
ANTHROPIC_MODEL=claude-sonnet-4-6
AEGIS_INTERNAL_KEY=            # shared secret that lets the watcher bypass public rate limits
RL_PER_MIN=8                   # public scans per minute per IP
RL_DAILY_MAX=500               # AI calls per day per instance
