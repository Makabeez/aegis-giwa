# Copy to deploy/.env (never commit .env). Fill in on the day mainnet opens.
RPC_URL=https://sepolia-rpc.giwa.io
CHAIN_ID=91342
EXPLORER_URL=https://sepolia-explorer.giwa.io

# Hot key that pays for the deploy. Ends with NO rights on the registry. Fund it with ~0.005 ETH only.
DEPLOYER_KEY=

# Address of the watcher's attester key (a fresh key for mainnet, holding at most ~0.01 ETH).
ATTESTER_ADDRESS=

# Your Ledger address. It becomes owner only after it calls acceptOwnership().
OWNER_ADDRESS=
